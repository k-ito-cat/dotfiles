{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "model": "opus",
  "effortLevel": "high",
  "autoMemoryEnabled": false,
  "permissions": {
    "defaultMode": "auto",
    "additionalDirectories": [
      "~/.local/share/chezmoi",
      "~/src/github.com/k-ito-cat/project-documents",
      "~/src/github.com/k-ito-cat/cli-kit",
      "~/.agents/skills",
      "~/.claude",
      "~/.codex",
      "~/.config/chezmoi",
      "~/.config/hunk",
      "~/.config/karabiner",
      "~/.config/lazysql",
      "~/.config/leaf",
      "~/.config/mise",
      "~/.config/navi",
      "~/.config/nvim",
      "~/.config/process-compose",
      "~/.config/sheldon",
      "~/.config/wezterm",
      "~/.config/yazi",
      "~/.config/zellij",
      "~/.config/zsh",
      "~/.config/zsh-abbr",
      "~/.local/bin",
      "~/.local/share/navi"
    ],
    "allow": [
      "Bash(chezmoi *)",
      "Bash(git add *)",
      "Bash(hunk session *)",
      "Bash(npm run build)",
      "Bash(npx -y modern-web-guidance@latest *)"
    ],
    "ask": [
      "Bash(rm -rf *)",
      "Bash(git push *)",
      "Bash(pnpm add *)",
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(bun add *)",
      "Bash(yarn add *)"
    ],
    "deny": [
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(sudo *)",
      "Bash(chmod 777 *)",
      "Bash(printenv)",
      "Bash(env)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/credentials)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)"
    ],
    "disableBypassPermissionsMode": "disable"
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": false,
    "allowUnsandboxedCommands": false,
    "failIfUnavailable": false,
    "filesystem": {
      "allowWrite": [
        "~/.local/share/chezmoi",
        "~/src/github.com/k-ito-cat/project-documents",
        "~/src/github.com/k-ito-cat/cli-kit",
        "~/.agents/skills",
        "~/.claude",
        "~/.codex",
        "~/.config/chezmoi",
        "~/.config/hunk",
        "~/.config/karabiner",
        "~/.config/lazysql",
        "~/.config/leaf",
        "~/.config/mise",
        "~/.config/navi",
        "~/.config/nvim",
        "~/.config/process-compose",
        "~/.config/sheldon",
        "~/.config/wezterm",
        "~/.config/yazi",
        "~/.config/zellij",
        "~/.config/zsh",
        "~/.config/zsh-abbr",
        "~/.local/bin",
        "~/.local/share/navi"
      ],
      "denyRead": [
        "~/.ssh",
        "~/.aws/credentials",
        "./.env",
        "./.env.*",
        "./secrets/**",
        "**/*.pem",
        "**/*.key"
      ]
    }
  }
}
