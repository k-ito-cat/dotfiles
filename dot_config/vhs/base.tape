# vhs のデモ共通のレイアウト。各 tape の先頭で Source "<HOME>/.config/vhs/base.tape" と読み込む

# ウィンドウ
Set Width 1200
Set Height 720
Set Padding 32
Set Margin 72
Set MarginFill "#141315"
Set WindowBar Rings
Set WindowBarSize 36
Set BorderRadius 8

# 文字（WezTerm の Menlo + Hiragino Sans に寄せる）
Set FontFamily "Menlo, Hiragino Sans"
Set FontSize 18
Set LineHeight 1.08
Set TypingSpeed 55ms
Set CursorBlink false

# 配色（WezTerm の 0x96f）
Set Theme { "name": "0x96f", "background": "#262427", "foreground": "#fcfcfa", "selection": "#545452", "cursor": "#ffca58", "black": "#262427", "red": "#ff7272", "green": "#bcdf59", "yellow": "#ffca58", "blue": "#49cae4", "magenta": "#a093e2", "purple": "#a093e2", "cyan": "#aee8f4", "white": "#fcfcfa", "brightBlack": "#545452", "brightRed": "#ff8787", "brightGreen": "#c6e472", "brightYellow": "#ffd271", "brightBlue": "#64d2e8", "brightMagenta": "#aea3e6", "brightPurple": "#aea3e6", "brightCyan": "#baebf6", "brightWhite": "#fcfcfa" }

Set Shell "zsh"
