# ===== Functions =====

# [Ctrl+N] navi: チートシート検索widgetを初期化する
if command -v navi >/dev/null 2>&1; then
  eval "$(navi widget zsh)"
fi

# [Alt+g] ghq+peco: リポジトリを選択してWezTermで開く
peco-src () {
  local selected_dir=$(ghq list -p | peco --prompt="repositories >" --query "$LBUFFER")
  if [ -n "$selected_dir" ]; then
    if [ -n "$ZELLIJ" ]; then
      # Zellij内: 別タブで開く
      local tab_name=${selected_dir:t}
      BUFFER="zellij action new-tab --cwd ${selected_dir:q} --name ${tab_name:q} -- ${SHELL:-/bin/zsh}"
    else
{{- if eq .chezmoi.os "darwin" }}
      local cwd
      cwd="$selected_dir"

      # Weztermで開く（macOS）
      if wezterm cli list >/dev/null 2>&1; then
        BUFFER="wezterm cli spawn --cwd ${cwd:q}"
      else
        BUFFER="wezterm start --cwd ${cwd:q}"
      fi
{{- else }}
      local win_cwd
      win_cwd=$(wslpath -w "$selected_dir")

      # Weztermで開く（WSL）
      if wezterm.exe cli list >/dev/null 2>&1; then
        BUFFER="wezterm.exe cli spawn --cwd ${win_cwd:q}"
      else
        BUFFER="wezterm.exe start --cwd ${win_cwd:q}"
      fi
{{- end }}
    fi

    zle accept-line
  fi
  zle clear-screen
}
# [peco-src] zle: widgetとして登録
zle -N peco-src

# [v] fzf+nvim: パスを直接、またはfzfで検索したファイルをneovimで開く
v() {
  local f query
  if [ "$#" -gt 0 ]; then
    if [ "$#" -eq 1 ] && [ -e "$1" ]; then
      nvim "$1"
      return
    fi

    query="$*"
    f="$(fzf --walker=file,dir,follow,hidden --query "$query" --select-1 --exit-0)" || return
  else
    f="$(fzf --walker=file,dir,follow,hidden)" || return
  fi

  [ -n "$f" ] && nvim "$f"
}

# [git-today] 今日のコミットをリポジトリ横断で選び、hunkで表示する
git-today() {
  emulate -L zsh
  setopt pipefail

  local since repo selected hash subject
  local -a repos entries
  since="$(date +%Y-%m-%d) 00:00:00"
  repos=("${(@f)$(ghq list --full-path)}" "$HOME/.local/share/chezmoi")

  for repo in "${repos[@]}"; do
    while IFS=$'\t' read -r hash subject; do
      [[ -n "$hash" ]] && entries+=("${repo:t}"$'\t'"${subject}"$'\t'"${repo}"$'\t'"${hash}")
    done < <(git -C "$repo" log --all --since="$since" --format=$'%h\t%s' 2>/dev/null)
  done

  (( ${#entries} )) || return 0

  selected=$(printf '%s\n' "${entries[@]}" | fzf \
    --delimiter=$'\t' \
    --with-nth='1,2' \
    --ansi \
    --gap \
    --preview='git -C {3} show --color=always --stat --format=fuller {4}' \
    --preview-window='right,60%,wrap') || return 0

  repo=$(printf '%s\n' "$selected" | cut -f3)
  hash=$(printf '%s\n' "$selected" | cut -f4)
  (cd "$repo" && hunk show "$hash")
}
