# ===== History =====

export HISTFILE="$HOME/.zsh_history"
# 新しい500件だけ残し、超えた分は古いものから消える（ファイルは上限の20%超えで切り詰められる）。
export HISTSIZE=500
export SAVEHIST=500
# 複数タブで履歴を共有しつつ、重複と余分な空白を抑える。
setopt APPEND_HISTORY SHARE_HISTORY HIST_IGNORE_DUPS HIST_REDUCE_BLANKS
# 先頭にスペースを付けたコマンドは残さない。実行時刻も記録しておく。
setopt HIST_IGNORE_SPACE EXTENDED_HISTORY

# 秘密情報らしい行は、今のセッションでは使えるようにしつつ履歴ファイルには書かない。
_history_skip_secrets() {
  emulate -L zsh
  setopt extendedglob
  [[ $1 == (#i)*(token|secret|passw|api[_-]#key|authorization:)* ]] && return 2
  return 0
}
autoload -Uz add-zsh-hook
add-zsh-hook zshaddhistory _history_skip_secrets
