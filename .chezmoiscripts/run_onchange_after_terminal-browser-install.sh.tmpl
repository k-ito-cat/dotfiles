#!/bin/bash
# Plugin: terminal-browser
# Official GitHub: https://github.com/zenbu-labs/terminal-browser
# 版と sha256 は .chezmoidata.toml で管理する。ダウンロードと sha256 の確認は .chezmoiexternal.toml で chezmoi が行い、
# このスクリプトは、置かれた配布ファイルの展開と起動用のファイルの作成だけを行う。

set -euo pipefail

{{ $tb := .terminalBrowser -}}
{{ $target := get $tb.targets (printf "%s/%s" .chezmoi.os .chezmoi.arch) -}}
{{ if not $target -}}
echo "terminal-browser does not support {{ .chezmoi.os }}/{{ .chezmoi.arch }}" >&2
exit 1
{{ end -}}
dist_dir="$HOME/.local/share/terminal-browser/dist"
tarball="$dist_dir/terminal-browser-{{ $tb.version }}-{{ $target }}.tar.gz"

data_home="${XDG_DATA_HOME:-$HOME/.local/share}"
bin_home="${XDG_BIN_HOME:-$HOME/.local/bin}"
state_home="${XDG_STATE_HOME:-$HOME/.local/state}"
app_dir="$data_home/terminal-browser/app"
receipt="$state_home/terminal-browser/skills.links"

if [ ! -f "$tarball" ]; then
  echo "terminal-browser: $tarball がない（chezmoi の外部ファイルの取得に失敗した可能性がある）" >&2
  exit 1
fi

rm -rf "$app_dir.new"
mkdir -p "$app_dir.new"
tar -xzf "$tarball" -C "$app_dir.new" --strip-components 1
pkill -f 'terminal-browser/app/browser/dist/main\.js' 2>/dev/null || true
rm -rf "$app_dir"
mv "$app_dir.new" "$app_dir"

mkdir -p "$bin_home"
{
  printf '%s\n' '#!/bin/sh'
  printf 'exec "%s/bin/terminal-browser" "$@"\n' "$app_dir"
} > "$bin_home/terminal-browser"
chmod +x "$bin_home/terminal-browser"

if [ -f "$receipt" ]; then
  while read -r skill_link; do
    [ -n "$skill_link" ] || continue
    [ -L "$skill_link" ] || continue
    case "$(readlink "$skill_link")" in
      "$app_dir"/*)
        rm -f "$skill_link"
        ;;
    esac
  done < "$receipt"
  rm -f "$receipt"
fi

if [ "$(uname -s)" = Linux ]; then
  missing_libraries="$(ldd "$app_dir/electron/electron" 2>/dev/null | awk '/not found/{print $1}' | sort -u)"
  if [ -n "$missing_libraries" ]; then
    echo "warning: terminal-browser is missing system libraries:" >&2
    printf '  %s\n' $missing_libraries >&2
    echo "sudo apt-get install libnss3 libgtk-3-0 libasound2t64 libgbm1" >&2
  fi
fi

# 前の版の配布ファイルを消す。今の版は chezmoi が管理している
find "$dist_dir" -name 'terminal-browser-*.tar.gz' ! -path "$tarball" -delete

echo "installed terminal-browser $(cat "$app_dir/VERSION")"
