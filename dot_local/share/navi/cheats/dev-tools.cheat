% brew bundle
; == Brew Bundle ==
# Brewfileを指定してインストール
brew bundle --file <Brewfile>
# Brewfileどおりにインストール
brew bundle install
# Brewfileとの差分確認
brew bundle check
# 現在環境からBrewfileを生成（上書き）
brew bundle dump --force

% mise
; == mise ==
# .mise.tomlに従ってインストール
mise install
# ローカルでツール/バージョンを使う
mise use <tool>@<version>
# インストール済み一覧
mise ls
# 実行バイナリの参照先を確認
mise which <tool>

% process-compose
; == process-compose ==
# プロジェクトを起動
process-compose up
# 指定プロセスだけ起動
process-compose up <process>
# 指定namespaceだけ起動
process-compose up -n <namespace>
# プロジェクトを停止
process-compose down
# プロセス一覧
process-compose process list
# namespace一覧
process-compose namespace list
# 設定を検証
process-compose up --dry-run

$ namespace: echo -e "app\ntools"

% api client
; == APIクライアント ==
# postingを起動
posting
# collectionを指定してpostingを起動
posting --collection <dir>

% sheldon
; == sheldon ==
# lockファイル更新
sheldon lock
# shell用のsource文字列を出力
sheldon source

% ghq
; == ghq ==
# リポジトリをクローン（GitHub短縮形可）
ghq get <repo>
# SSHでクローン
ghq get -p <repo>
# 既存ならpullで更新
ghq get -u <repo>
# 管理リポジトリ一覧
ghq list
# フルパス付き一覧
ghq list -p
# ルートディレクトリ確認
ghq root
# 新規ローカルリポジトリ作成
ghq create <name>

% adrs
; == adrs ==
# ADR一覧（番号・status・日付・タイトル）
adrs list -l
# statusで絞り込み
adrs list -l --status <status>
# 日付以降で絞り込み
adrs list -l --since <date>
# 全文検索
adrs search <query>
# タイトルのみ検索
adrs search -t <query>
# 大文字小文字を区別して検索
adrs search -c <query>
# リポジトリ健全性チェック（連番重複・リンク切れ・必須節）
adrs doctor
# 指定ルールを抑制してチェック
adrs doctor --ignore <rule>
# 目次をMarkdownで出力
adrs generate toc
# 関係グラフをGraphviz形式で出力
adrs generate graph
# mdbookを生成
adrs generate book
# 設定内容を表示
adrs config
# 別ディレクトリを対象に実行
adrs -C <dir> list -l
# よく使う操作のクイックリファレンス
adrs cheatsheet

$ status: echo -e "proposed\naccepted\ndeprecated\nsuperseded\nrejected\ndraft"
$ rule: echo -e "ADR004\nADR005\nADR007\nADR013\nADR017"
