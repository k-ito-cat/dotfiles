% cli-kit
; == pdocs ==
# プロジェクトを選び、記入漏れと未判断を洗い出す（記入・ステータス・未決事項・ADR）
pdocs stat
# プロジェクトを指定して表示
pdocs stat <project>
# ステータスの件数だけ表示
pdocs stat --status <project>
# 記入状況だけ表示
pdocs stat --fill <project>
# 未決事項だけ表示
pdocs stat --open <project>
# ルールからの逸脱を検査する（文書地図・ステータス値・見出し構成・エントリのID・成果物の有無・品質特性の確認手段。問題があれば終了コード1）
pdocs check
# プロダクトREADMEの文書地図の漏れとリンク切れだけ検査
pdocs check --readme
# 定義にないステータス値だけ検査
pdocs check --status
# プロダクト文書の見出し構成が雛形と一致しているかだけ検査
pdocs check --template
# エントリのIDの有無・重複・参照先だけ検査
pdocs check --id
# 文章以外で定義するもの（成果物）の有無だけ検査。未完了は警告
pdocs check --sources
# 品質特性の水準（ID・ステータス・基準と水準・確認手段）だけ検査。未決定・未確立は警告
pdocs check --quality
# 雛形にない項目名を警告として一覧にする（既定の検査には含まれない）
pdocs check --items
# 接頭辞（FRQ など）の次に使うIDを表示
pdocs id <project> <prefix>
# IDの定義と、参照している場所を表示
pdocs id <project> <id>

; == recap ==
# 今日のコミットで変わったファイルを選び、差分・yazi・今の中身で開く（ファイル→開き方の順にEnterで選ぶ）
recap today
# 指定した日（2026-09-25、09-25、yesterday）のコミットで変わったファイルを選んで開く
recap today --date <date>
# 直近7日のコミットで変わったファイルを選び、差分・yazi・今の中身で開く
recap week
# 今日のまだ要約していないコミットの要点を、リポジトリごとにAIがまとめて記録に追記する（新しいコミットが無ければAIは呼ばない）
recap today --summary
# 指定した日のまだ要約していないコミットの要点をまとめて記録に追記する
recap today --date <date> --summary
# 直近7日のまだ要約していないコミットの要点をまとめて記録に追記する
recap week --summary
# 差分も材料にして、より具体的にまとめる（トークンを多く使う）
recap week --summary --deep
# 要約済みの範囲も含めて、直近7日をもう一度要約する
recap week --summary --force
# 要約の記録（月ごと）を選び、batで読むかyaziで開く
recap log

; == skl ==
# dotfilesで管理するSkillを、カテゴリごとにスキル名と用途の一覧で表示
skl list

$ project: cd "$PDOCS_DIR" && ls -1d */ | sed 's#/$##' | grep -v '^_'
$ prefix: grep -o '| `[A-Z]\{3\}`' "$PDOCS_DIR/documentation-policy.md" | tr -d '|` ' | sort -u
$ date: for i in 0 1 2 3 4 5 6; do date -v-${i}d +%Y-%m-%d 2>/dev/null || date -d "-$i day" +%Y-%m-%d; done
