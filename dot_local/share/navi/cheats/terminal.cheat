% terminal

; == よく使う（ターミナル） ==
# 今いる場所
pwd
# 移動
cd <dir>
# 移動（zoxide）
z <一部>
# 移動（zoxide / 複数キーワードで絞り込み）
z <一部1> <一部2>
# 移動（zoxide / fzfで選択）
zi
# 移動（zoxide / 直前のディレクトリ）
z -
# 一覧（zoxide / スコア順）
zoxide query -l
# 追加（zoxide / 手動登録）
zoxide add <dir>
# 削除（zoxide）
zoxide remove <dir>
# 編集（zoxide / DBを対話編集）
zoxide edit
# 表示（cat）
cat <file>
# 編集（neovim）
nvim <file>

% terminal-browser
; == terminal-browser ==
# URLを開く
terminal-browser open <url>
# ローカルファイルをfile URLで開く
terminal-browser open "file://$(realpath <file>)"
# 起動中のブラウザを一覧表示
terminal-browser ls
# 全ブラウザを終了
terminal-browser shutdown
# ブラウザ操作用CLIを開く
terminal-browser action
# 終了キー
printf '%s\n' 'macOS: Ctrl+Q / Ctrl+C | Linux: Ctrl+Q'
# 新しいタブ
printf '%s\n' 'macOS: Cmd+T | Linux: Ctrl+T'
# URLを編集
printf '%s\n' 'macOS: Cmd+L | Linux: Ctrl+L'
# コマンドパレット
printf '%s\n' 'macOS: Cmd+P | Linux: Ctrl+K / Alt+K'
# ページ内検索
printf '%s\n' 'macOS: Cmd+Shift+F | Linux: Ctrl+Shift+F'
# 再読み込み
printf '%s\n' 'macOS: Cmd+R | Linux: Ctrl+R'
# 戻る / 進む
printf '%s\n' 'macOS: Cmd+[ / Cmd+] | Linux: Ctrl+[ / Ctrl+]'
# ポップアップやオーバーレイを閉じる
printf '%s\n' 'Esc'

% file search
; == 検索（ファイル/中身） ==
# zsh関数 v の定義を参照
cat ~/.config/zsh/20-functions.zsh
# ファイル名指定で開く（zsh関数）
v <file>
# fzfで選んで開く（zsh関数）
v
# ファイル名検索（fzf）
fzf
# 中身検索（ripgrep）
rg <語> .

% ni
; == ni ==
# 依存インストール
ni
# 依存追加
ni <pkg>
# dev依存追加
ni -D <pkg>
# グローバル追加
ni -g <pkg>
# scripts一覧から選択して実行
nr
# 指定scriptを実行
nr <script>

% hunk
; == hunk ==
# 作業ツリー全体をレビュー（未追跡ファイルを含む）
hunk diff
# 作業ツリーの変更を自動更新しながらレビュー
hunk diff --watch
# 最新コミットをレビュー
hunk show
# 指定したコミットをレビュー
hunk show <revision>
# キー一覧を表示
printf '%s\n' '?'
# 終了
printf '%s\n' 'q'
# 分割表示
printf '%s\n' '1'
# 縦積み表示
printf '%s\n' '2'
