#!/usr/bin/env python3
# 個人利用の project-documents 専用CLI。現状はパッケージ化による運用上のメリットがないため、
# 当面は単一スクリプトとして管理する。
"""project-documents のプロダクト文書の統計と、文書地図・ステータスの検査を行う。

ステータスの定義・必須文書は documentation-policy.md、共通運用へのリンクは _template/README.md から
実行のたびに読み取る。この CLI には値を持たない。
"""

import argparse
import os
import re
import shutil
import subprocess
import sys
import unicodedata
from dataclasses import dataclass, field
from pathlib import Path

ROOT = Path(os.environ.get("PDOCS_DIR", "~/src/github.com/k-ito-cat/project-documents")).expanduser()
TEMPLATE = ROOT / "_template"
POLICY = ROOT / "documentation-policy.md"
TARGET_DIRS = ("spec", "design")

ITEM_RE = re.compile(r"^\s*- ([^:：\n`]+?)(?:：|:(?=\s|$))[ \t]*(.*?)\s*$")
LINK_RE = re.compile(r"\[[^\]]*\]\(([^)\s]+)\)")
HEADING_RE = re.compile(r"^(#{1,6})\s+(.*?)\s*$")


def fail(msg: str) -> None:
    print(f"pdocs: {msg}", file=sys.stderr)
    sys.exit(2)


def width(s: str) -> int:
    return sum(2 if unicodedata.east_asian_width(c) in "WF" else 1 for c in s)


def pad(s: str, w: int, right: bool = False) -> str:
    gap = " " * (w - width(s))
    return gap + s if right else s + gap


STYLES = {"red": "31", "yellow": "33", "green": "32", "cyan": "36", "dim": "2", "bold": "1"}
USE_COLOR = False


def paint(text: str, *styles: str) -> str:
    if not USE_COLOR or not styles:
        return text
    return "\x1b[" + ";".join(STYLES[s] for s in styles) + "m" + text + "\x1b[0m"


def color_enabled(mode: str) -> bool:
    """--color の指定を優先し、auto では NO_COLOR（空でない値）と端末かどうかで決める。"""
    if mode != "auto":
        return mode == "always"
    return not os.environ.get("NO_COLOR") and sys.stdout.isatty()


def read(path: Path) -> list[str]:
    return path.read_text(encoding="utf-8").split("\n")


def section(lines: list[str], title: str) -> list[str]:
    """見出し title の節の本文を、次の同階層以上の見出しまで返す。"""
    out, level = [], None
    for line in lines:
        m = HEADING_RE.match(line)
        if m and level is not None and len(m.group(1)) <= level:
            break
        if level is not None:
            out.append(line)
        elif m and m.group(2) == title:
            level = len(m.group(1))
    return out


def table_rows(lines: list[str]) -> list[tuple[list[str], list[list[str]]]]:
    """Markdown の表を (見出し, 本文行) の組で返す。"""
    tables, i = [], 0
    while i < len(lines):
        if lines[i].startswith("|") and i + 1 < len(lines) and re.fullmatch(r"[|\s:-]+", lines[i + 1] or "x"):
            head = [c.strip() for c in lines[i].strip().strip("|").split("|")]
            body, i = [], i + 2
            while i < len(lines) and lines[i].startswith("|"):
                body.append([c.strip() for c in lines[i].strip().strip("|").split("|")])
                i += 1
            tables.append((head, body))
        else:
            i += 1
    return tables


def without_code(lines: list[str]) -> list[str]:
    out, fenced = [], False
    for line in lines:
        if line.lstrip().startswith("```"):
            fenced = not fenced
            out.append("")  # 行番号を元のファイルと揃える
            continue
        out.append("" if fenced else line)
    return out


def load_statuses() -> dict[str, str]:
    """documentation-policy.md の「ステータス」表から ID→ラベル を読む。"""
    for head, body in table_rows(section(read(POLICY), "ステータス")):
        if "ID" in head and "ラベル" in head:
            i, j = head.index("ID"), head.index("ラベル")
            return {row[i]: row[j] for row in body if len(row) > max(i, j)}
    fail(f"{POLICY} にステータス表が見つかりません")


def projects() -> list[str]:
    return sorted(p.name for p in ROOT.iterdir()
                  if p.is_dir() and not p.name.startswith(("_", ".")) and (p / "README.md").is_file())


def choose(names: list[str]) -> str | None:
    if not shutil.which("fzf"):
        fail("fzf が見つかりません。プロジェクト名を引数で指定してください")
    r = subprocess.run(["fzf", "--prompt=project> "], input="\n".join(names), text=True, capture_output=True)
    return r.stdout.strip() or None


# ---- 記入状況 ----------------------------------------------------------------

@dataclass
class FileStat:
    path: str
    items: int = 0
    filled: int = 0
    statuses: dict[str, int] = field(default_factory=dict)
    blank: int = 0
    invalid: list[tuple[str, str]] = field(default_factory=list)
    open_items: list[str] = field(default_factory=list)


def stat_file(path: Path, rel: str, ids: dict[str, str]) -> FileStat:
    st = FileStat(rel, statuses={k: 0 for k in ids})
    lines = without_code(read(path))

    def count_status(value: str, where: str) -> None:
        if not value:
            st.blank += 1
        elif value in ids:
            st.statuses[value] += 1
        else:
            st.invalid.append((where, value))

    for n, line in enumerate(lines, 1):
        m = ITEM_RE.match(line)
        if not m:
            continue
        key, value = m.group(1).strip(), m.group(2)
        if key == "ステータス":
            count_status(value, str(n))
        elif key == "未決事項":
            if value:
                st.open_items.append(value)
        else:
            st.items += 1
            st.filled += bool(value)

    for head, body in table_rows(lines):
        if "ステータス" in head:
            k = head.index("ステータス")
            for row in body:
                count_status(row[k] if k < len(row) else "", "表")

    open_sec = section(lines, "未決事項")
    st.open_items += [l.strip()[2:] for l in open_sec if l.strip().startswith("- ")]
    st.open_items += [" / ".join(r[:1]) for _, body in table_rows(open_sec) for r in body]
    return st


def render_table(stats: list[FileStat], ids: dict[str, str], aspects: set[str]) -> str:
    head = ["文書"]
    if "fill" in aspects:
        head += ["記入"]
    if "status" in aspects:
        head += [*ids.values(), "未記", "不正"]
    if "open" in aspects:
        head += ["未決"]

    def row(s: FileStat) -> list[str]:
        r = [s.path]
        if "fill" in aspects:
            r += [f"{s.filled}/{s.items}"]
        if "status" in aspects:
            r += [*(str(s.statuses[k]) for k in ids), str(s.blank), str(len(s.invalid))]
        if "open" in aspects:
            r += [str(len(s.open_items))]
        return r

    total = FileStat("合計", statuses={k: sum(s.statuses[k] for s in stats) for k in ids})
    for s in stats:
        total.items += s.items; total.filled += s.filled; total.blank += s.blank
        total.invalid += s.invalid; total.open_items += s.open_items
    rows = [row(s) for s in stats]
    widths = [max(width(r[i]) for r in [head, *rows, row(total)]) for i in range(len(head))]
    line = paint("+" + "+".join("-" * (w + 2) for w in widths) + "+", "dim")
    bar = paint("|", "dim")

    def fmt(r: list[str], styles=None) -> str:
        cells = [paint(pad(c, w, right=i > 0), *(styles(head[i], c) if styles and i > 0 else ()))
                 for i, (c, w) in enumerate(zip(r, widths))]
        return f"{bar} " + f" {bar} ".join(cells) + f" {bar}"

    head_row = f"{bar} " + f" {bar} ".join(paint(pad(c, w, right=i > 0), "bold")
                                           for i, (c, w) in enumerate(zip(head, widths))) + f" {bar}"
    return "\n".join([line, head_row, line, *(fmt(r, cell_style) for r in rows), line,
                      fmt(row(total), cell_style), line])


def cell_style(col: str, value: str) -> tuple[str, ...]:
    """記入は全部なら緑・一部なら黄・なしなら薄く、未記入は黄、不正は赤、0 は薄く表示する。"""
    if col == "記入":
        done, total = map(int, value.split("/"))
        return ("green",) if total and done == total else ("dim",) if done == 0 else ("yellow",)
    if value == "0":
        return ("dim",)
    return {"未記": ("yellow",), "不正": ("red", "bold")}.get(col, ())

# ---- 検査 --------------------------------------------------------------------

@dataclass
class Finding:
    project: str
    aspect: str  # readme / status / template / items
    level: str  # error（問題）/ warn（警告）/ info（参考）
    file: str
    line: int | None
    text: str
    note: str = ""


def slug(text: str) -> str:
    text = re.sub(r"[^\w\s-]", "", text.strip().lower())
    return re.sub(r"\s", "-", text)


def links(lines: list[str]) -> list[str]:
    return [t for l in lines for t in LINK_RE.findall(l) if not re.match(r"[a-z]+:", t)]


def check_link(base: Path, target: str) -> str | None:
    """リンク先の問題を返す。問題がなければ None。"""
    path, _, anchor = target.partition("#")
    dest = (base / path).resolve() if path else None
    if dest is None or not dest.exists():
        return "リンク切れ"
    if anchor and dest.is_file():
        heads = {slug(m.group(2)) for l in read(dest) if (m := HEADING_RE.match(l))}
        if slug(anchor) not in heads:
            return "リンク先の見出しがない"
    return None


def check_readme(add) -> None:
    """各プロダクト README が必須文書と共通運用を直接指し、リンク切れがないか。"""
    required = [t.removeprefix("_template/") for t in links(section(read(POLICY), "必須")) if t.startswith("_template/spec/")]
    common = [t for t in links(read(TEMPLATE / "README.md")) if t.startswith("../documentation-policy.md")]
    for name in projects():
        pj = ROOT / name
        pj_links = links(read(pj / "README.md"))
        err = lambda text, note: add(Finding(name, "readme", "error", "README.md", None, text, note))
        for doc in required:
            if not (pj / doc).exists():
                err(doc, "必須文書がない")
            elif not any(t.partition("#")[0] == doc for t in pj_links):
                err(doc, "文書地図に載っていない")
        for t in common:
            if t not in pj_links:
                err(t, "文書地図に載っていない")
        for t in pj_links:
            if note := check_link(pj, t):
                err(t, note)

def check_status(ids: dict[str, str], add) -> None:
    for name in [*projects(), "_template"]:
        for d in TARGET_DIRS:
            for f in sorted((ROOT / name / d).rglob("*.md")):
                rel = str(f.relative_to(ROOT / name))
                for where, value in stat_file(f, rel, ids).invalid:
                    add(Finding(name, "status", "error", rel, int(where) if where.isdigit() else None,
                                value, "定義にないステータス" + ("（表）" if where == "表" else "")))

# ---- 雛形との構成比較 ----------------------------------------------------------

ROOT_PARENT = "文書直下"
ANY_H2 = "各##節"


def norm_heading(text: str) -> str:
    return re.sub(r"\s+", " ", text.replace("`", "")).strip()


def headings(path: Path) -> list[tuple[int, int, str]]:
    """(行番号, 深さ, 見出し) を返す。コードブロック内は除く。"""
    return [(n, len(m.group(1)), norm_heading(m.group(2)))
            for n, l in enumerate(without_code(read(path)), 1) if (m := HEADING_RE.match(l))]


def load_entry_rules() -> dict[str, list[tuple[int, str, object]]]:
    """方針の「見出しの構成と繰り返すエントリ」表から、雛形ごとの繰り返す見出しと置く節を読む。"""
    rules: dict[str, list[tuple[int, str, object]]] = {}
    for head, body in table_rows(section(read(POLICY), "見出しの構成と繰り返すエントリ")):
        if not {"雛形", "繰り返す見出し", "置く節"} <= set(head):
            continue
        i, j, k = head.index("雛形"), head.index("繰り返す見出し"), head.index("置く節")
        for row in body:
            tmpl = row[i].strip("` ")
            stub = re.match(r"(#+)\s+(.*)", row[j].strip("` "))
            place = row[k].replace("`", "").replace(" ", "")
            if not stub:
                continue
            if place in (ROOT_PARENT, ANY_H2):
                parent: object = place
            else:
                pm = re.match(r"(#+)(.*)", place)
                parent = (len(pm.group(1)), norm_heading(pm.group(2))) if pm else place
            rules.setdefault(tmpl, []).append((len(stub.group(1)), norm_heading(stub.group(2)), parent))
    if not rules:
        fail(f"{POLICY} に見出しの構成の表が見つかりません")
    return rules


def template_for(rel: Path) -> Path | None:
    parts = rel.parts
    if parts[0] == "decisions" and rel.name != "README.md":
        return None  # ADR 本体は adrs が管理する
    if parts[0] == "operations":
        rel = Path("operations/runbook.md")
    return rel


def compare_structure(tmpl_rel: str, tmpl: Path, target: Path, rules) -> tuple[list[tuple[int, str]], list[str]]:
    """雛形にない見出し（NG）と、採用していない雛形の見出し（未採用）を返す。"""
    stubs = rules.get(tmpl_rel, [])
    is_stub = lambda lv, tx: any(lv == a and tx == b for a, b, _ in stubs)

    # 雛形の固定見出し（スタブとその子孫を除く）と、スタブごとの子見出し
    fixed: set[tuple] = set()
    stub_children: dict[str, set[str]] = {}
    chain: list[tuple[int, str]] = []
    in_stub: tuple[int, str] | None = None
    for _, lv, tx in headings(tmpl):
        if lv == 1:
            chain = []
            continue
        chain = [c for c in chain if c[0] < lv] + [(lv, tx)]
        if in_stub and lv > in_stub[0]:
            stub_children.setdefault(in_stub[1], set()).add(tx)
            continue
        in_stub = None
        if is_stub(lv, tx):
            in_stub = (lv, tx)
            continue
        fixed.add(tuple(chain))

    # スタブ直後の最初の項目名。エントリは同じ項目から書き始める
    first_key: dict[tuple[int, str], str] = {}
    tl = read(tmpl)
    for i, l in enumerate(tl):
        m = HEADING_RE.match(l.strip())
        if m and is_stub(len(m.group(1)), norm_heading(m.group(2))):
            k = next((re.match(r"^- ([^:：]+)[:：]", x) for x in tl[i + 1:] if x.strip()), None)
            if k:
                first_key[(len(m.group(1)), norm_heading(m.group(2)))] = k.group(1).strip()

    def opens_with(n: int, key: str) -> bool:
        body = read(target)[n:]
        head = next((x for x in body if x.strip()), "")
        return re.match(rf"^- {re.escape(key)}[:：]", head) is not None

    ng, seen = [], set()
    chain = []
    entry: tuple[int, str] | None = None
    for n, lv, tx in headings(target):
        if lv == 1:
            chain = []
            continue
        chain = [c for c in chain if c[0] < lv] + [(lv, tx)]
        if entry and lv > entry[0]:
            if tx not in stub_children.get(entry[1], set()):
                ng.append((n, f"{'#' * lv} {tx}"))
            continue
        entry = None
        path = tuple(chain)
        if path in fixed:
            seen.add(path)
            continue
        parent = chain[-2] if len(chain) > 1 else None
        for slv, stx, place in stubs:
            if lv != slv:
                continue
            if (place == ROOT_PARENT and parent is None) or (place == ANY_H2 and parent and parent[0] == 2) \
                    or (isinstance(place, tuple) and parent == place):
                key = first_key.get((slv, stx))
                if key is None or opens_with(n, key):
                    entry = (lv, stx)
                break
        if entry is None:
            ng.append((n, f"{'#' * lv} {tx}"))
    missing = [" > ".join(t for _, t in p) for p in sorted(fixed - seen, key=len)]
    return ng, missing


def item_keys(path: Path, include_code: bool = False) -> list[tuple[int, str]]:
    """行頭の `- 項目名:` を (行番号, 項目名) で返す。雛形の型はコードブロック内にもあるため include_code で含める。"""
    lines = read(path) if include_code else without_code(read(path))
    return [(n, m.group(1).strip()) for n, l in enumerate(lines, 1)
            if (m := re.match(r"^- ([^:：`]+?)(?:：|:(?=\s|$))", l))]


def pj_files(pj: Path) -> list[Path]:
    return [pj / "README.md", *sorted(pj.glob("spec/**/*.md")), *sorted(pj.glob("design/**/*.md")),
            *sorted(pj.glob("decisions/README.md")), *sorted(pj.glob("prototype/README.md")),
            *sorted(pj.glob("operations/*.md"))]


def section_of(path: Path) -> list[str]:
    """行番号（1 始まり）ごとに、その行が属する見出しを返す。"""
    out, cur = [""], ""
    for l in without_code(read(path)):
        if m := HEADING_RE.match(l):
            cur = norm_heading(m.group(2))
        out.append(cur)
    return out


def free_sections(tmpl: Path) -> set[str]:
    """雛形で項目を持たない見出し（文書地図、Index、未決事項など自由に書く節）。"""
    owner = section_of(tmpl)
    with_items = {owner[n] for n, _ in item_keys(tmpl)}
    return {norm_heading(m.group(2)) for l in without_code(read(tmpl)) if (m := HEADING_RE.match(l))} - with_items


def check_items(add) -> None:
    """雛形にない項目名を警告として並べる（問題の件数には数えない）。"""
    for name in projects():
        pj = ROOT / name
        for f in pj_files(pj):
            tmpl_rel = template_for(f.relative_to(pj))
            if tmpl_rel is None or not (TEMPLATE / tmpl_rel).exists():
                continue
            known = {k for _, k in item_keys(TEMPLATE / tmpl_rel, include_code=True)}
            free = free_sections(TEMPLATE / tmpl_rel)
            owner = section_of(f)
            for n, k in item_keys(f):
                if k not in known and owner[n] not in free:
                    add(Finding(name, "items", "warn", str(f.relative_to(pj)), n, k, "雛形にない項目"))


def check_template(add) -> None:
    rules = load_entry_rules()
    for name in projects():
        pj = ROOT / name
        for f in pj_files(pj):
            rel = f.relative_to(pj)
            tmpl_rel = template_for(rel)
            if tmpl_rel is None:
                continue
            tmpl = TEMPLATE / tmpl_rel
            if not tmpl.exists():
                add(Finding(name, "template", "error", str(rel), None, str(tmpl_rel), "雛形がない"))
                continue
            ng, missing = compare_structure(str(tmpl_rel), tmpl, f, rules)
            for n, head in ng:
                add(Finding(name, "template", "error", str(rel), n, head, "雛形にない見出し"))
            if missing:
                add(Finding(name, "template", "info", str(rel), None, " / ".join(missing),
                            f"未採用 {len(missing)} 節"))


def run_checks(ids: dict[str, str], aspects: set[str]) -> list[Finding]:
    found: list[Finding] = []
    if "readme" in aspects:
        check_readme(found.append)
    if "status" in aspects:
        check_status(ids, found.append)
    if "template" in aspects:
        check_template(found.append)
    if "items" in aspects:
        check_items(found.append)
    return found


# ---- 検査結果の表示 --------------------------------------------------------------

ASPECTS = [("readme", "文書地図"), ("status", "ステータス値"), ("template", "見出し構成"), ("items", "項目名")]
MARK = {"error": ("✗", "red"), "warn": ("!", "yellow"), "info": ("·", "dim"), "ok": ("✓", "green")}


def tally(fs: list[Finding]) -> tuple[int, int]:
    return sum(f.level == "error" for f in fs), sum(f.level == "warn" for f in fs)


def tally_text(err: int, warn: int) -> str:
    parts = [paint(f"✗ {err} 問題", "red", "bold")] if err else []
    parts += [paint(f"! {warn} 警告", "yellow")] if warn else []
    return "  ".join(parts) or paint("✓ 問題なし", "green")


def render_findings(found: list[Finding], aspects: set[str]) -> list[str]:
    """PJ → 検査の種類 → ファイルの順にまとめて表示する。"""
    names = projects() + (["_template"] if any(f.project == "_template" for f in found) else [])
    out: list[str] = []
    for name in names:
        fs = [f for f in found if f.project == name]
        out.append(f"{paint(name, 'bold')}  {tally_text(*tally(fs))}")
        for key, label in ASPECTS:
            if key not in aspects or (name == "_template" and key != "status"):
                continue
            af = [f for f in fs if f.aspect == key]
            err, warn = tally(af)
            mark, color = MARK["error" if err else "warn" if warn else "ok"]
            count = f"  {paint(str(err or warn), color)}" if err or warn else ""
            # 説明がすべて同じなら見出しに一度だけ出す
            notes = {f.note for f in af if f.level != "info"}
            shared = notes.pop() if len(notes) == 1 else None
            out.append(f"  {paint(mark, color)} {label}" + (paint(f"（{shared}）", "dim") if shared else "") + count)
            for file in dict.fromkeys(sorted(f.file for f in af)):
                ff = sorted((f for f in af if f.file == file), key=lambda f: (f.level != "error", f.line or 0))
                n = sum(f.level != "info" for f in ff)
                out.append(f"      {paint(file, 'cyan')}" + (paint(f"  ({n})", "dim") if n > 1 else ""))
                loc_w = max(width(f"L{f.line}") if f.line else 0 for f in ff)
                for f in ff:
                    m, c = MARK[f.level]
                    if f.level == "info":
                        out.append(f"        {paint(f'{m} {f.note}: {f.text}', c)}")
                        continue
                    loc = f"{paint(pad(f'L{f.line}' if f.line else '', loc_w), 'dim')}  " if loc_w else ""
                    note = "" if shared else f"  {paint(f.note, 'dim')}"
                    out.append(f"        {paint(m, c)} {loc}{f.text}{note}")
        out.append("")
    err, warn = tally(found)
    clean = sum(1 for n in names if not tally([f for f in found if f.project == n])[0])
    out.append(paint("─" * 40, "dim"))
    if not err and not warn:
        out.append(paint(f"✓ {len(names)} PJ すべて問題なし", "green"))
    else:
        out.append(f"{tally_text(err, warn)}   {clean}/{len(names)} PJ で問題なし")
    return out

# ---- main --------------------------------------------------------------------

def cmd_check(ids: dict[str, str], aspects: set[str]) -> int:
    found = run_checks(ids, aspects)
    print("\n".join(render_findings(found, aspects)))
    return 1 if tally(found)[0] else 0

def cmd_stat(ids: dict[str, str], project: str | None, aspects: set[str], show_all: bool) -> int:
    names = projects()
    name = project or choose(names)
    if not name:
        return 0
    if name not in names:
        fail(f"プロジェクトが見つかりません: {name}")

    pj = ROOT / name
    stats = [stat_file(f, str(f.relative_to(pj)), ids)
             for d in TARGET_DIRS for f in sorted((pj / d).rglob("*.md"))]
    print(paint(name, "bold"))
    print(render_table(stats, ids, aspects))

    if "open" in aspects:
        open_items = [(s.path, o) for s in stats for o in s.open_items]
        if open_items:
            print(paint("\n未決事項:", "bold"))
            for path, item in open_items:
                print(f"  - {path}: {item}")
    if "status" in aspects:
        invalid = [(s.path, w, v) for s in stats for w, v in s.invalid]
        if invalid:
            print(paint("\n不正なステータス値:", "red", "bold"))
            for path, where, value in invalid:
                print(f"  {paint('✗', 'red')} {paint(f'{path}:{where}', 'cyan')}  {value}")
    if not show_all:
        return 0

    print(paint("\nADR:", "bold"))
    if not (pj / "adrs.toml").exists():
        print("  (adrs.toml なし)")
    elif not shutil.which("adrs"):
        print("  (adrs が見つかりません)")
    else:
        r = subprocess.run(["adrs", "-C", str(pj), "list", "-l"], text=True, capture_output=True)
        print("\n".join("  " + l for l in (r.stdout or r.stderr).rstrip().split("\n")))

    err, warn = tally([f for f in run_checks(ids, {"readme", "status", "template"}) if f.project == name])
    print(f"\n検査: {tally_text(err, warn)}" + ("（pdocs check で詳細）" if err else ""))
    return 0


def main() -> int:
    ap = argparse.ArgumentParser(prog="pdocs", description=__doc__.split("\n")[0])
    sub = ap.add_subparsers(dest="command", required=True)
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--color", choices=["auto", "always", "never"], default="auto",
                        help="色付け（auto は端末のときだけ。NO_COLOR が設定されていれば付けない）")

    st = sub.add_parser("stat", parents=[common], help="プロダクト文書の統計を表示する（観点の指定がなければ全て）")
    st.add_argument("project", nargs="?", help="対象プロジェクト名（省略時は fzf で選択）")
    st.add_argument("--status", action="store_true", help="ステータスの件数")
    st.add_argument("--fill", action="store_true", help="項目の記入状況")
    st.add_argument("--open", action="store_true", help="未決事項")

    ck = sub.add_parser("check", parents=[common], help="文書地図とステータス値を検査する（観点の指定がなければ全て）")
    ck.add_argument("--readme", action="store_true", help="プロダクトREADMEの文書地図の漏れとリンク切れ")
    ck.add_argument("--status", action="store_true", help="定義にないステータス値")
    ck.add_argument("--template", action="store_true", help="プロダクト文書の見出し構成と雛形の一致")
    ck.add_argument("--items", action="store_true", help="雛形にない項目名（警告のみ。既定の検査には含めない）")

    args = ap.parse_args()
    global USE_COLOR
    USE_COLOR = color_enabled(args.color)
    if not ROOT.is_dir():
        fail(f"{ROOT} が見つかりません（PDOCS_DIR で変更できます）")
    ids = load_statuses()

    if args.command == "check":
        all_checks = {"readme", "status", "template"}
        aspects = {a for a in all_checks | {"items"} if getattr(args, a)} or all_checks
        return cmd_check(ids, aspects)
    chosen = {a for a in ("status", "fill", "open") if getattr(args, a)}
    return cmd_stat(ids, args.project, chosen or {"status", "fill", "open"}, show_all=not chosen)


if __name__ == "__main__":
    sys.exit(main())
